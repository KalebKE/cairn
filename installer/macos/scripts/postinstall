#!/bin/bash
# Cairn -- macOS postinstall script
# Runs after .pkg payload is installed to ~/Library/Cairn.
# Configures Claude Desktop and initializes Cairn data directory.

set -euo pipefail

INSTALL_DIR="$HOME/Library/Cairn"
PYTHON="$INSTALL_DIR/python/bin/python3"
CONFIGURE="$INSTALL_DIR/configure_claude.py"

echo "Cairn: Running post-install configuration..."

# Configure Claude Desktop (inject MCP server entry)
if [ -f "$CONFIGURE" ]; then
    "$PYTHON" "$CONFIGURE" --install-dir "$INSTALL_DIR"
else
    echo "WARNING: configure_claude.py not found at $CONFIGURE"
    exit 1
fi

# Run cairn setup to initialize data directory (~/.cairn)
"$PYTHON" -m cairn setup 2>/dev/null || echo "WARNING: cairn setup did not complete (will retry on first use)"

echo "Cairn: Installation complete!"
echo ""
echo "Next steps:"
echo "  1. Restart Claude Desktop"
echo "  2. Say 'What MCP tools do you have?' to verify Cairn loaded"
echo ""
echo "Opening quickstart guide..."

# Open quickstart guide in browser
open "https://tracqi.com/get-started?ref=installer-mac" 2>/dev/null || true

exit 0
